# Copy to .env and fill in. Never commit .env.
# Leave the key blank to run in extractive-only mode (no LLM call).

# Generator model A (primary)
VN_RAG_LLM_A_API_KEY=
VN_RAG_LLM_A_BASE_URL=http://127.0.0.1:11434/v1
VN_RAG_LLM_A_MODEL=

# Judge model B (must be a different model family from A)
VN_RAG_LLM_B_API_KEY=
VN_RAG_LLM_B_BASE_URL=
VN_RAG_LLM_B_MODEL=